---
import { Image } from "astro:assets";
import { ChevronDown } from "@lucide/astro";
import LogoUNE from "../../assets/logos/une-enlinea.png";

const secciones = ["Admisiones", "Oferta académica", "Nosotros", "Vida estudiantil"];
---

<header class="sticky top-0 z-50 w-full border-t-4 border-azul-une bg-white/50 shadow-sm backdrop-blur-[10.2px]">
  <div class="flex h-20 w-full items-center justify-between gap-6 px-4 sm:px-6 lg:h-24">
    <Image
      src={LogoUNE}
      alt="UNE en línea"
      class="h-16 w-auto max-w-full shrink-0 lg:h-24"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hidden items-center gap-6 text-black lg:flex" aria-label="Secciones de muestra">
      {secciones.map((seccion) => (
        <button
          type="button"
          disabled
          class="flex min-h-11 items-center gap-1 py-2 text-left text-xs font-bold min-[375px]:text-sm lg:px-2 lg:text-base"
        >
          {seccion}
          <ChevronDown size={16} class="shrink-0" aria-hidden="true" />
        </button>
      ))}
    </div>
  </div>
</header>
