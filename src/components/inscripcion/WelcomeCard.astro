---
import { Image } from "astro:assets";
import Portada from "../../assets/imagenes/portada3_mobile.jpg";
---

<aside
  aria-labelledby="bienvenida-inscripcion"
  class="welcome-panel relative isolate grid min-h-[780px] min-w-0 overflow-hidden bg-[#f5f5f5] text-white max-[720px]:min-h-[660px]"
>
  <Image
    src={Portada}
    alt="Estudiante de UNE en línea"
    class="absolute inset-0 -z-2 h-full w-full object-fill"
    loading="eager"
    fetchpriority="high"
  />
  <div class="welcome-copy relative px-7 py-9 max-[1000px]:px-[22px] max-[1000px]:py-7 max-[720px]:px-[26px] max-[720px]:py-[30px]">
    <h1
      class="text-[clamp(24px,2.3vw,30px)] leading-[1.2] font-bold tracking-[-0.5px] max-[720px]:max-w-[440px] max-[720px]:text-[28px]"
      id="bienvenida-inscripcion"
    >
      ¡Bienvenidos a nuestro portal de inscripciones!
    </h1>
    <span
      class="my-5 block h-1 w-12 rounded bg-[#77ceff]"
      aria-hidden="true"
    ></span>
    <p class="text-[13px] leading-[1.75] font-normal text-white max-[720px]:max-w-[500px]">
      A continuación, se te solicitarán algunos datos personales para completar
      tu solicitud de inscripción a UNE en línea. Una vez que envíes la
      información, nuestro equipo revisará tu solicitud y se pondrá en contacto
      contigo para orientarte sobre la documentación y los pasos necesarios para
      finalizar el proceso. ¡Gracias por tu confianza!
    </p>
  </div>
  <div class="min-h-0" aria-hidden="true"></div>
</aside>
<style>
  .welcome-panel {
    /* Keep the photograph above the divider and reserve the lower region for the logo. */
    grid-template-rows: minmax(max-content, 3fr) minmax(0, 2fr);
  }
  .welcome-copy {
    background: linear-gradient(180deg, rgb(0 12 35 / 78%), rgb(0 12 35 / 60%));
  }
</style>
