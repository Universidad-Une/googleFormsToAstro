---
import { CAMPOS_INSCRIPCION } from "../../server/inscripcion.js";
import WelcomeCard from "./WelcomeCard.astro";
import {
  LoaderCircle,
  ArrowRight,
  UserRound,
  GraduationCap,
  Phone,
  Mail,
  UsersRound,
  ChevronDown,
} from "@lucide/astro";
const orden = [
  "nombres",
  "programaAcademico",
  "telefonoContacto",
  "correo",
  "edad",
];
const iconos = {
  nombres: UserRound,
  programaAcademico: GraduationCap,
  telefonoContacto: Phone,
  correo: Mail,
  edad: UsersRound,
};
const campos = orden.map((nombre) =>
  CAMPOS_INSCRIPCION.find(([campo]) => campo === nombre)!,
);
const adicionales = CAMPOS_INSCRIPCION.filter(([campo]) =>
  ["mediosSeleccionados", "compromiso"].includes(campo),
);
---

<section class="inscripcion-backdrop grid min-h-svh items-center px-7 py-12 text-[#10163c] max-[720px]:px-3.5 max-[720px]:py-5">
  <div class="mx-auto grid w-full max-w-[1160px] grid-cols-[minmax(280px,32%)_minmax(0,1fr)] overflow-hidden rounded-[14px] bg-white shadow-[0_12px_48px_#1c467314] max-[1000px]:grid-cols-[30%_minmax(0,1fr)] max-[720px]:grid-cols-1">
    <WelcomeCard />
    <form
      id="formulario-inscripcion"
      class="min-w-0 px-12 pt-[35px] pb-6 max-[1000px]:px-[26px] max-[1000px]:py-8 max-[720px]:px-[22px] max-[720px]:py-7"
    >
      <div class="[&_h2]:mb-6 [&_h2]:text-[28px] [&_h2]:leading-[1.2] [&_h2]:font-bold max-[720px]:[&_h2]:text-2xl">
        <span
          class="mb-[18px] block h-1 w-[38px] rounded bg-[#0067ff]"
          aria-hidden="true"
        ></span>
        <h2>Datos personales</h2>
      </div>
      <div class="grid grid-cols-2 gap-x-5 gap-y-[17px] max-[420px]:grid-cols-1">
        {campos.map(([campo, id, tipo, obligatorio, titulo, opciones = []]) => {
          const Icono = iconos[campo as keyof typeof iconos];
          return (
            <div
              class:list={[
                "[&_label]:mb-[7px] [&_label]:block [&_label]:text-[13px] [&_label]:font-medium",
                { "col-span-full": campo === "nombres" },
              ]}
              data-field={campo}
              data-type={tipo}
              data-question-id={id}
            >
              <label for={campo}>
                {titulo} <span class="pl-[3px] text-[#0059ff]">*</span>
              </label>
              <div class="control relative flex items-center text-[#7589ba]">
                <Icono size={21} aria-hidden="true" />
                {campo === "programaAcademico" || campo === "edad" ? (
                  <>
                    <select
                      id={campo}
                      name={campo}
                      required={obligatorio}
                      aria-describedby={campo + "-error"}
                    >
                      <option value="" disabled selected>
                        {campo === "edad"
                          ? "Selecciona un rango de edad"
                          : "Selecciona tu programa"}
                      </option>
                      {opciones.map((opcion) => (
                        <option value={opcion}>{opcion}</option>
                      ))}
                    </select>
                    <ChevronDown
                      size={17}
                      class="select-arrow"
                      aria-hidden="true"
                    />
                  </>
                ) : (
                  <input
                    id={campo}
                    name={campo}
                    aria-describedby={campo + "-error"}
                    type={
                      campo === "correo"
                        ? "email"
                        : campo === "telefonoContacto"
                          ? "tel"
                          : "text"
                    }
                    autocomplete={
                      campo === "nombres"
                        ? "name"
                        : campo === "correo"
                          ? "email"
                          : campo === "telefonoContacto"
                            ? "tel"
                            : "off"
                    }
                    placeholder={
                      campo === "telefonoContacto"
                        ? "Teléfono o WhatsApp a 10 dígitos"
                        : campo === "correo"
                          ? "Tu correo electrónico"
                          : "Escribe tu nombre completo"
                    }
                    inputmode={
                      campo === "telefonoContacto" ? "numeric" : undefined
                    }
                    pattern={
                      campo === "telefonoContacto" ? "[0-9]{10}" : undefined
                    }
                    title={
                      campo === "telefonoContacto"
                        ? "Escribe 10 dígitos, sin espacios ni lada internacional."
                        : undefined
                    }
                    maxlength={campo === "telefonoContacto" ? 10 : 500}
                    required={obligatorio}
                  />
                )}
              </div>
              <p
                id={campo + "-error"}
                data-field-error
                class="mt-1.5 text-xs leading-relaxed text-red-600 empty:hidden"
                aria-live="polite"
              ></p>
            </div>
          );
        })}
      </div>
      {adicionales.map(
        ([
          campo,
          id,
          tipo,
          obligatorio,
          titulo,
          opciones = [],
          permiteOtro = false,
        ]) => (
          <section
            class="mt-6 border-t border-[#dce5f4] pt-[13px] [&_h2]:mb-1.5 [&_h2]:text-[17px] [&_h2]:leading-[1.35] [&_h2]:font-bold"
            data-field={campo}
            data-type={tipo}
            data-question-id={id}
            aria-labelledby={campo + "-heading"}
          >
            {campo === "compromiso" ? (
              <>
                <div class="flex items-baseline gap-2 text-[13px] leading-[1.7] text-[#52658a] [&_label]:cursor-pointer">
                  <input
                    id="aceptar-terminos"
                    name="compromiso"
                    type="checkbox"
                    value="Sí"
                    required={obligatorio}
                    aria-labelledby="compromiso-heading"
                  />
                  <span id="compromiso-heading">
                    <label for="aceptar-terminos">He leído y acepto los </label>
                    <button
                      type="button"
                      class="inline min-h-auto cursor-pointer rounded-none bg-transparent p-0 text-inherit font-normal text-[#ff2938] underline hover:text-[#d71928]"
                      id="abrir-terminos"
                    >
                      términos y condiciones.
                    </button>
                  </span>
                </div>
                <dialog
                  class="m-auto max-h-[80svh] w-[min(560px,calc(100%_-_32px))] overflow-auto rounded-xl border-0 p-7 text-[#344b85] shadow-[0_20px_80px_#001a7133] backdrop:bg-[#071c4b80] [&_p]:mt-4 [&_p]:mb-6 [&_p]:text-sm [&_p]:leading-[1.8]"
                  id="terminos-dialog"
                  aria-labelledby="terminos-titulo"
                >
                  <h2 id="terminos-titulo">Compromiso y autorización</h2>
                  <p>{titulo}</p>
                  <button
                    type="button"
                    id="cerrar-terminos"
                    class="inline-flex min-h-12 cursor-pointer items-center justify-center gap-3 rounded-[7px] bg-[#ff2938] px-7 py-3 text-[13px] font-bold text-white transition-colors duration-200 hover:bg-[#e51e2d] disabled:cursor-wait disabled:opacity-60"
                  >
                    Cerrar
                  </button>
                </dialog>
              </>
            ) : (
              <>
                <h2 id={campo + "-heading"}>
                  {campo === "compromiso"
                    ? "Compromiso y autorización"
                    : "¿Cómo nos conociste?"}
                </h2>
                <fieldset class="m-0 min-w-0 border-0 p-0">
                  <legend class="mb-2.5 text-[11px] leading-[1.55] font-normal whitespace-pre-line text-[#526079]">
                    {titulo} <span class="pl-[3px] text-[#0059ff]">*</span>
                  </legend>
                  <div
                    class:list={[
                      "choices",
                      { "media-choices": tipo === "CHECKBOX" },
                    ]}
                  >
                    {opciones.map((opcion, index) => (
                      <label
                        class="choice inline-flex min-h-8 cursor-pointer items-center gap-2 text-[13px] font-medium"
                        for={campo + "-" + index}
                      >
                        <input
                          id={campo + "-" + index}
                          name={campo}
                          type={tipo === "CHECKBOX" ? "checkbox" : "radio"}
                          value={opcion}
                          required={tipo === "MULTIPLE_CHOICE" && obligatorio}
                        />
                        <span>{opcion}</span>
                      </label>
                    ))}
                    {permiteOtro && (
                      <div class="flex min-w-0 gap-1.5">
                        <label
                          class="choice inline-flex min-h-8 cursor-pointer items-center gap-2 text-[13px] font-medium"
                          for={campo + "-otro"}
                        >
                          <input
                            id={campo + "-otro"}
                            name={campo}
                            type="checkbox"
                            value="__otro__"
                            data-other-choice
                          />
                          <span>Otro</span>
                        </label>
                        <input
                          type="text"
                          id={campo + "-otro-texto"}
                          aria-label={"Otra respuesta: " + titulo}
                          data-other-text
                          maxlength="500"
                          disabled
                        />
                      </div>
                    )}
                  </div>
                </fieldset>
              </>
            )}
          </section>
        ),
      )}
      <div class="mt-6 flex justify-end max-[1000px]:mt-[18px]">
        <button
          type="submit"
          class="inline-flex min-h-12 cursor-pointer items-center justify-center gap-3 rounded-[7px] bg-[#ff2938] px-7 py-3 text-[13px] font-bold text-white transition-colors duration-200 hover:bg-[#e51e2d] disabled:cursor-wait disabled:opacity-60 w-1/2 max-[420px]:w-full"
        >
          <LoaderCircle
            size={19}
            class="hidden animate-spin"
            data-loader
            aria-hidden="true"
          />
          <span data-label>Enviar formulario</span>
          <ArrowRight size={19} aria-hidden="true" />
        </button>
      </div>
      <p
        class="mt-[18px] text-[13px] text-[#344b85] empty:hidden"
        id="estado-inscripcion"
        role="status"
        aria-live="polite"
        tabindex="-1"
      ></p>
    </form>
  </div>
</section>

<style>
  .inscripcion-backdrop {
    background: radial-gradient(ellipse at 50% 40%, #fff 15%, #f0f6fb 100%);
  }
  .control > :global(svg:first-child) {
    position: absolute;
    left: 15px;
    pointer-events: none;
  }
  .control input,
  select {
    width: 100%;
    min-width: 0;
    height: 44px;
    border: 1px solid #d2ddf1;
    border-radius: 6px;
    background: #fcfdff;
    padding: 0 14px 0 48px;
    font: inherit;
    font-size: 12px;
    color: #344b85;
  }
  select {
    appearance: none;
    padding-right: 32px;
  }
  .control input[aria-invalid="true"],
  .control select[aria-invalid="true"] {
    border-color: #dc2626;
    background-color: #fff8f8;
  }
  .control :global(.select-arrow) {
    position: absolute;
    right: 13px;
    pointer-events: none;
  }
  input:focus-visible,
  select:focus-visible,
  button:focus-visible {
    outline: 3px solid #0069ef50;
    outline-offset: 2px;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .media-choices .choice {
    border: 1px solid #d8e2f4;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 10px;
    color: #344b85;
  }
  .media-choices .choice:has(input:checked) {
    background: #edf4ff;
    border-color: #4489ff;
  }
  input[type="checkbox"],
  input[type="radio"] {
    width: 15px;
    height: 15px;
    accent-color: #0069ff;
    flex-shrink: 0;
    margin: 0;
  }
  input[type="radio"] {
    width: 19px;
    height: 19px;
  }
  .choices:not(.media-choices) {
    gap: 26px;
  }
  [data-other-text] {
    width: 120px;
    min-width: 0;
    border: 1px solid #d2ddf1;
    border-radius: 6px;
    padding: 7px;
    font-size: 11px;
  }
  [data-other-text]:disabled {
    background: #f8faff;
  }
</style>

<script>
  import {
    CAMPOS_INSCRIPCION,
    validarInscripcion,
  } from "../../server/inscripcion.js";
  const form = document.querySelector<HTMLFormElement>(
    "#formulario-inscripcion",
  )!;
  const submit = form.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  )!;
  const status = document.querySelector<HTMLParagraphElement>(
    "#estado-inscripcion",
  )!;

  const termsDialog =
    form.querySelector<HTMLDialogElement>("#terminos-dialog")!;
  form
    .querySelector("#abrir-terminos")!
    .addEventListener("click", () => termsDialog.showModal());
  form
    .querySelector("#cerrar-terminos")!
    .addEventListener("click", () => termsDialog.close());

  const mensajes: Record<string, string> = {
    nombres: "Escribe tu nombre.",
    programaAcademico: "Selecciona tu programa académico.",
    edad: "Selecciona un rango de edad.",
    telefonoContacto:
      "Escribe un teléfono o WhatsApp de 10 dígitos, sin espacios ni lada internacional.",
    correo: "Escribe un correo válido, por ejemplo: nombre@dominio.com.",
  };

  function validarCampo(control: HTMLInputElement | HTMLSelectElement) {
    const grupo = control.closest<HTMLElement>("[data-field]");
    const mensaje = grupo?.querySelector<HTMLElement>("[data-field-error]");
    if (!grupo || !mensaje) return;
    control.setCustomValidity("");
    const { errors } = validarInscripcion(recolectar());
    const invalido =
      !control.validity.valid || Boolean(errors[grupo.dataset.field!]);
    const texto = invalido
      ? mensajes[grupo.dataset.field!] || "Revisa este campo."
      : "";
    control.setCustomValidity(texto);
    control.setAttribute("aria-invalid", String(invalido));
    mensaje.textContent = texto;
  }

  for (const grupo of form.querySelectorAll<HTMLElement>("[data-field]")) {
    if (!grupo.querySelector("[data-field-error]")) continue;
    const control = grupo.querySelector<HTMLInputElement | HTMLSelectElement>(
      "input, select",
    )!;
    control.addEventListener("blur", () => validarCampo(control));
    control.addEventListener("change", () => validarCampo(control));
    control.addEventListener("input", () => {
      if (control.hasAttribute("aria-invalid")) validarCampo(control);
    });
    control.addEventListener("invalid", () => validarCampo(control));
  }

  function sincronizarOpciones() {
    for (const group of form.querySelectorAll<HTMLElement>("[data-field]")) {
      const other = group.querySelector<HTMLInputElement>(
        "[data-other-choice]",
      );
      const text = group.querySelector<HTMLInputElement>("[data-other-text]");
      if (other && text) {
        text.disabled = !other.checked;
        text.required = other.checked;
        text.setCustomValidity(
          other.checked && !text.value.trim()
            ? "Escribe tu respuesta en Otro."
            : "",
        );
      }
      if (group.dataset.type === "CHECKBOX") {
        const first = group.querySelector<HTMLInputElement>(
          'input[type="checkbox"]',
        )!;
        first.setCustomValidity(
          group.querySelector('input[type="checkbox"]:checked')
            ? ""
            : "Selecciona al menos un medio.",
        );
      }
    }
  }
  form.addEventListener("change", sincronizarOpciones);
  form.addEventListener("input", sincronizarOpciones);
  sincronizarOpciones();

  function recolectar() {
    const data: Record<string, string | string[]> = {};
    for (const group of form.querySelectorAll<HTMLElement>("[data-field]")) {
      const campo = group.dataset.field!;
      if (
        campo === "programaAcademico" ||
        campo === "edad" ||
        group.dataset.type === "LIST"
      ) {
        data[campo] = group.querySelector<HTMLSelectElement>("select")!.value;
      } else if (group.dataset.type === "TEXT") {
        data[campo] = group
          .querySelector<HTMLInputElement>("input")!
          .value.trim();
      } else {
        const values = Array.from(
          group.querySelectorAll<HTMLInputElement>("input:checked"),
          (input) =>
            input.hasAttribute("data-other-choice")
              ? group
                  .querySelector<HTMLInputElement>("[data-other-text]")!
                  .value.trim()
              : input.value,
        );
        data[campo] =
          group.dataset.type === "CHECKBOX" ? values : values[0] || "";
      }
    }
    return data;
  }
  function datosValidos() {
    sincronizarOpciones();
    for (const control of form.querySelectorAll<
      HTMLInputElement | HTMLSelectElement
    >("input[aria-describedby], select[aria-describedby]")) {
      validarCampo(control);
    }
    if (!form.reportValidity()) return null;
    const { data, errors } = validarInscripcion(recolectar());
    if (Object.keys(errors).length) {
      status.textContent =
        "Revisa estos campos: " + Object.keys(errors).join(", ");
      status.focus();
      return null;
    }
    return data;
  }
  function mostrarCarga(
    button: HTMLButtonElement,
    loading: boolean,
    label: string,
  ) {
    button.disabled = loading;
    button.setAttribute("aria-busy", String(loading));
    button.querySelector("[data-loader]")!.classList.toggle("hidden", !loading);
    button.querySelector("[data-label]")!.textContent = label;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (submit.disabled) return;
    const data = datosValidos();
    if (!data) return;
    mostrarCarga(submit, true, "Enviando…");
    status.textContent = "Estamos guardando tu inscripción. Espera un momento.";
    try {
      const response = await fetch("/api/forms/inscripcion", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(data),
        signal: AbortSignal.timeout(35000),
      });
      const result = await response.json();
      if (response.ok && result.success === true) {
        status.textContent =
          "Tu solicitud se registró correctamente. Redirigiendo…";
        window.location.assign("/gracias");
        return;
      }
      status.textContent =
        result.message ||
        "No pudimos confirmar la inscripción. Verifica si se registró antes de repetir el envío.";
    } catch {
      status.textContent =
        "No pudimos confirmar el registro. Verifica si se guardó antes de repetir el envío.";
    }
    mostrarCarga(submit, false, "Enviar formulario");
    status.focus();
  });
</script>
